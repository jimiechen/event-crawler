{
  "name": "Baidu Search Xiaomi Car",
  "nodes": [
    {
      "parameters": {},
      "id": "start-node",
      "name": "When clicking \"Execute Workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://www.baidu.com/s?wd=%E5%B0%8F%E7%B1%B3%E6%B1%BD%E8%BD%A6",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
            }
          ]
        }
      },
      "id": "http-request",
      "name": "Baidu Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": ".c-container h3",
              "returnArray": true
            }
          ]
        }
      },
      "id": "html-extract",
      "name": "Extract Titles",
      "type": "n8n-nodes-base.htmlExtract",
      "typeVersion": 1,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Keep only top 3 titles and format\nconst titles = items[0].json.title || [];\nconst top3 = titles.slice(0, 3);\n\nreturn [\n  {\n    json: {\n      titles: top3,\n      count: top3.length,\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
      "id": "process-data",
      "name": "Format Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        910,
        300
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "/Users/mac/ok-mcp/app/n8n-demo/search_results.json",
        "fileContent": "={{JSON.stringify($json, null, 2)}}"
      },
      "id": "save-file",
      "name": "Save to File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1130,
        300
      ]
    }
  ],
  "connections": {
    "When clicking \"Execute Workflow\"": {
      "main": [
        [
          {
            "node": "Baidu Search",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Baidu Search": {
      "main": [
        [
          {
            "node": "Extract Titles",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Titles": {
      "main": [
        [
          {
            "node": "Format Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Data": {
      "main": [
        [
          {
            "node": "Save to File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {},
  "staticData": null,
  "tags": []
